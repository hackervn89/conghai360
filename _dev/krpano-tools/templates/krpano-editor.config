# Ninhphuoc360 Editor — Custom Multi-Resolution Config

include basicsettings.config

panotype=autodetect
hfov=360
makescenes=true

# output
flash=false
html5=true

# convert spherical/cylindrical to cubical
converttocube=true
converttocubelimit=360x45

# multiresolution settings
multires=true
tilesize=512
levels=auto
levelstep=2
maxsize=auto
maxcubesize=auto

# output images path — inside the scene folder (INPUTPATH)
tilepath=%INPUTPATH%/panos/%BASENAME%.tiles/[c/]l%Al/%Av/l%Al[_c]_%Av_%Ah.jpg

# preview pano settings
preview=true
graypreview=false
previewsmooth=25
previewpath=%INPUTPATH%/panos/%BASENAME%.tiles/preview.jpg

# generate thumbnail
makethumb=true
thumbsize=240
thumbpath=%INPUTPATH%/panos/%BASENAME%.tiles/thumb.jpg

# xml output — scene definition
xml=true
xmlpath=%INPUTPATH%/%BASENAME%.xml
xmltemplate=xml/vtour.xml

# NO html output
html=false

# compression settings
jpegquality=82
jpegsubsamp=422
jpegoptimize=false
